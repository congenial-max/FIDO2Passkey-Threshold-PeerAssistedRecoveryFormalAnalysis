    (ServerSendsRecoveryData( A, s_share, enc_fido ) @ #q) ⇒ ⊥) ∧
  (∃ #z. (K( ltk ) @ #z))"
*/
simplify
solve( State_A_2( $A, $B1, $B2, $B3, pkPeerB1, pkPeerB2, pkPeerB3
       ) ▶₀ #d )
  case Initiator_Receives_Peer_Keys
  solve( C2S_Rcv( $A, 'Server', <'1_init_peer', $B1, $B2, $B3> ) ▶₀ #vr.8 )
    case C2S_Receive
    solve( !LtkUser( $A, ltk ) ▶₁ #d )
      case Register_User
      solve( !KU( ~ltk_user ) @ #vk )
        case Reveal_Ltk_User
        by contradiction /* from formulas */
      next
        case Reveal_Peer_Storage_case_1
        solve( C2S_Rcv( $A, 'Server',
                        <'3_store_pkg', pk(~ltk_user), srv(~ltk_user, ~r), 
                         aenc(<'share', shr1(~ltk_user, ~r), $A>, pk(~ltk_peer)), $B1, 
                         aenc(<'share', shr2(~ltk_user, ~r), $A>, pk(~ltk_peer.1)), $B2, 
                         aenc(<'share', shr3(~ltk_user, ~r), $A>, pk(~ltk_peer.2)), $B3>
               ) ▶₀ #vr.15 )
          case C2S_Receive
          solve( !KU( ~ltk_peer ) @ #vk.1 )
            case Reveal_Ltk_Peer
            solve( !KU( srv(~ltk_user, ~r) ) @ #vk.2 )
              case Reveal_Server_Storage
              by contradiction /* from formulas */
            next
              case Server_Sends_Recovery_Data
              by contradiction /* from formulas */
            next
              case c_srv
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case Reveal_Peer_Storage_case_2
        solve( C2S_Rcv( $A, 'Server',
                        <'3_store_pkg', pk(~ltk_user), srv(~ltk_user, ~r), 
                         aenc(<'share', shr1(~ltk_user, ~r), $A>, pk(~ltk_peer)), $B1, 
                         aenc(<'share', shr2(~ltk_user, ~r), $A>, pk(~ltk_peer.1)), $B2, 
                         aenc(<'share', shr3(~ltk_user, ~r), $A>, pk(~ltk_peer.2)), $B3>
               ) ▶₀ #vr.15 )
          case C2S_Receive
          solve( !KU( ~ltk_peer ) @ #vk.1 )
            case Reveal_Ltk_Peer
            solve( !KU( srv(~ltk_user, ~r) ) @ #vk.2 )
              case Reveal_Server_Storage
              by contradiction /* from formulas */
            next
              case Server_Sends_Recovery_Data
              by contradiction /* from formulas */
            next
              case c_srv
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case Reveal_Peer_Storage_case_3
        solve( C2S_Rcv( $A, 'Server',
                        <'3_store_pkg', pk(~ltk_user), srv(~ltk_user, ~r), 
                         aenc(<'share', shr1(~ltk_user, ~r), $A>, pk(~ltk_peer)), $B1, 
