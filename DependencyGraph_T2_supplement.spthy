lemma all_peers_without_server_insufficient [heuristic={reconstruction_secrecy}]:
  all-traces
  "∀ A ltk #d.
    ((((SharesDealt( A, ltk ) @ #d) ∧ (¬(∃ #l. LtkRevealUser( A ) @ #l))) ∧
      (¬(∃ #s. ServerStorageRevealed( A ) @ #s))) ∧
     (¬(∃ s_share enc_fido #q.
         ServerSendsRecoveryData( A, s_share, enc_fido ) @ #q))) ⇒
    (¬(∃ #z. K( ltk ) @ #z))"
/*
guarded formula characterizing all counter-examples:
"∃ A ltk #d.
  (SharesDealt( A, ltk ) @ #d)
 ∧
  (∀ #l. (LtkRevealUser( A ) @ #l) ⇒ ⊥) ∧
