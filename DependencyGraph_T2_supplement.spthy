lemma all_peers_premise_reachable [heuristic={executability}]:
  exists-trace
  "∃ A ltk B1 B2 B3 #d #n #r1 #r2 #r3.
    (((((((SharesDealt( A, ltk ) @ #d) ∧
          (Nominated_All( A, B1, B2, B3 ) @ #n)) ∧
         (LtkRevealPeer( B1 ) @ #r1)) ∧
        (LtkRevealPeer( B2 ) @ #r2)) ∧
       (LtkRevealPeer( B3 ) @ #r3)) ∧
      (¬(∃ #l. LtkRevealUser( A ) @ #l))) ∧
     (¬(∃ #s. ServerStorageRevealed( A ) @ #s))) ∧
    (¬(∃ s_share enc_fido #q.
        ServerSendsRecoveryData( A, s_share, enc_fido ) @ #q))"
/*
guarded formula characterizing all satisfying traces:
"∃ A ltk B1 B2 B3 #d #n #r1 #r2 #r3.
  (SharesDealt( A, ltk ) @ #d) ∧
  (Nominated_All( A, B1, B2, B3 ) @ #n) ∧
  (LtkRevealPeer( B1 ) @ #r1) ∧
  (LtkRevealPeer( B2 ) @ #r2) ∧
  (LtkRevealPeer( B3 ) @ #r3)
 ∧
  (∀ #l. (LtkRevealUser( A ) @ #l) ⇒ ⊥) ∧
  (∀ #s. (ServerStorageRevealed( A ) @ #s) ⇒ ⊥) ∧
  (∀ s_share enc_fido #q.
    (ServerSendsRecoveryData( A, s_share, enc_fido ) @ #q) ⇒ ⊥)"
*/
simplify
solve( State_A_2( $A, $B1, $B2, $B3, pkPeerB1, pkPeerB2, pkPeerB3
       ) ▶₀ #d )
  case Initiator_Receives_Peer_Keys
  solve( !LtkUser( $A, ltk ) ▶₁ #d )
    case Register_User
    solve( !LtkPeer( $B1, ltk ) ▶₀ #r1 )
      case Register_User
      solve( !LtkPeer( $B2, ltk ) ▶₀ #r2 )
        case Register_User
        solve( !LtkPeer( $B3, ltk ) ▶₀ #r3 )
          case Register_User
          solve( C2S_Rcv( $A, 'Server', <'1_init_peer', $B1, $B2, $B3> ) ▶₀ #vr.7 )
            case C2S_Receive
            SOLVED // trace found
          qed
        qed
      qed
    qed
  qed
qed

