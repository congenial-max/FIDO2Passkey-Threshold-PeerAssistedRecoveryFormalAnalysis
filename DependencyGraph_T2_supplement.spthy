lemma isolation_own_peer_key_compromise:
  all-traces
  "∀ A fido_key H1 H2 #i #h.
    ((((((A_Recovers_FIDO_Key( A, fido_key ) @ #i) ∧
         (HelpersSelected( A, H1, H2 ) @ #h)) ∧
        (∃ #l. LtkRevealPeer( A ) @ #l)) ∧
       (¬(∃ #l. LtkRevealUser( A ) @ #l))) ∧
      (¬(∃ #l. LtkRevealPeer( H1 ) @ #l))) ∧
     (¬(∃ #l. LtkRevealPeer( H2 ) @ #l))) ⇒
    (¬(∃ #z. K( fido_key ) @ #z))"
/*
guarded formula characterizing all counter-examples:
"∃ A fido_key H1 H2 #i #h.
  (A_Recovers_FIDO_Key( A, fido_key ) @ #i) ∧
  (HelpersSelected( A, H1, H2 ) @ #h)
 ∧
  (∃ #l. (LtkRevealPeer( A ) @ #l)) ∧
  (∀ #l. (LtkRevealUser( A ) @ #l) ⇒ ⊥) ∧
