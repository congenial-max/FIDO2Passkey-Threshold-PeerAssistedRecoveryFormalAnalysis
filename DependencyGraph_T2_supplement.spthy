theory ECS_FIDO2PasskeyRecovery_Threshold2of3

begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, fst/1, pair/2, pk/1, rec/3, shr1/2, shr2/2,
           shr3/2, snd/1, srv/2
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    rec(srv(k, r), shr1(k, r), shr2(k, r)) = k,
    rec(srv(k, r), shr1(k, r), shr3(k, r)) = k,
    rec(srv(k, r), shr2(k, r), shr3(k, r)) = k,
    snd(<x.1, x.2>) = x.2

tactic: reconstruction_secrecy
presort: C
prio: {id}
  regex"State_A_" | regex"!Stored"
prio: {id}
  regex"Sec_" | regex"_Rcv\("
deprio: {id}
  regex"!KU\(srv\(" | regex"!KU\(shr"
deprio: {id}
  regex"!KU\(rec\("
tactic: tightness_witness
presort: S
prio: {id}
  regex"!KU\(rec\("
prio: {id}
  regex"!KU\(srv\(" | regex"!KU\(shr"
prio: {id}
  regex"State_A_" | regex"!Stored"
tactic: executability
presort: S
prio: {id}
  regex"State_A_"
prio: {id}
  regex"!Stored"

heuristic: {reconstruction_secrecy}

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

restriction Inequality:
  "∀ x #i. (Neq( x, x ) @ #i) ⇒ (⊥)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i. (Neq( x, x ) @ #i) ⇒ (⊥)"
  */

restriction OneSetupPerUser:
  "∀ A pkU1 pkP1 pkU2 pkP2 #i #j.
    ((MainKeysGenerated( A, pkU1, pkP1 ) @ #i) ∧
     (MainKeysGenerated( A, pkU2, pkP2 ) @ #j)) ⇒
    (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ A pkU1 pkP1 pkU2 pkP2 #i #j.
    ((MainKeysGenerated( A, pkU1, pkP1 ) @ #i) ∧
     (MainKeysGenerated( A, pkU2, pkP2 ) @ #j)) ⇒
    (#i = #j)"
  */

restriction OneDealingPerUser:
  "∀ A k1 k2 #i #j.
    ((SharesDealt( A, k1 ) @ #i) ∧ (SharesDealt( A, k2 ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ A k1 k2 #i #j.
    ((SharesDealt( A, k1 ) @ #i) ∧ (SharesDealt( A, k2 ) @ #j)) ⇒ (#i = #j)"
  */

restriction OneNominationPerUser:
  "∀ A B1 B2 B3 C1 C2 C3 #i #j.
    ((Nominated_All( A, B1, B2, B3 ) @ #i) ∧
     (Nominated_All( A, C1, C2, C3 ) @ #j)) ⇒
    (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ A B1 B2 B3 C1 C2 C3 #i #j.
    ((Nominated_All( A, B1, B2, B3 ) @ #i) ∧
     (Nominated_All( A, C1, C2, C3 ) @ #j)) ⇒
    (#i = #j)"
  */

rule (modulo E) C2S_Send:
   [ C2S_Snd( A, B, m ) ] --> [ Sec_C2S( A, B, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) C2S_Receive:
   [ Sec_C2S( A, B, m ) ]
  --[ AUTO_OUT_FACT_0_Server_Receives_And_Forwards_Package( A, B, m ) ]->
   [ C2S_Rcv( A, B, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) S2C_Send:
   [ S2C_Snd( A, B, m ) ] --> [ Sec_S2C( A, B, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) S2C_Receive:
   [ Sec_S2C( A, B, m ) ] --> [ S2C_Rcv( A, B, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) P2P_Send:
   [ P2P_Snd( A, B, m ) ] --> [ Sec_P2P( A, B, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) P2P_Receive:
   [ Sec_P2P( A, B, m ) ] --> [ P2P_Rcv( A, B, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Ltk_User[color=#ffcccc]:
   [ !LtkUser( $A, ltk ) ] --[ LtkRevealUser( $A ) ]-> [ Out( ltk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Ltk_Peer[color=#ffccaa]:
   [ !LtkPeer( $A, ltk ) ] --[ LtkRevealPeer( $A ) ]-> [ Out( ltk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Peer_Storage[color=#ffddcc]:
   [ !StoredEncryptedSubkey( $B, $A, cipher ) ]
  --[ PeerStorageRevealed( $B, $A ) ]->
   [ Out( cipher ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Server_Storage[color=#ff6666]:
   [ !StoredPackage( $A, $B1, $B2, $B3, pkA, srv_share, c1, c2, c3 ) ]
  --[ ServerStorageRevealed( $A ) ]->
   [ Out( srv_share ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Register_User:
   [ Fr( ~ltk_user ), Fr( ~ltk_peer ) ]
  --[
  MainKeysGenerated( $A, pk(~ltk_user), pk(~ltk_peer) ),
  UserRegistered( $A, 'Client' )
  ]->
   [
   !RegisteredUser( $A, 'Client' ), !LtkUser( $A, ~ltk_user ),
   !PkUser( $A, pk(~ltk_user) ), Out( pk(~ltk_user) ),
   !LtkPeer( $A, ~ltk_peer ), !PkPeer( $A, pk(~ltk_peer) ),
   Out( pk(~ltk_peer) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Initiator_Nominates_Peers:
   [
   !RegisteredUser( $A, 'Client' ), !RegisteredUser( $B1, 'Client' ),
   !RegisteredUser( $B2, 'Client' ), !RegisteredUser( $B3, 'Client' )
   ]
  --[
  Initiated( $A, $B1 ), Initiated( $A, $B2 ), Initiated( $A, $B3 ),
  Nominated_All( $A, $B1, $B2, $B3 ), Neq( $A, $B1 ), Neq( $A, $B2 ),
  Neq( $A, $B3 ), Neq( $B1, $B2 ), Neq( $B1, $B3 ), Neq( $B2, $B3 )
  ]->
   [
   C2S_Snd( $A, 'Server', <'1_init_peer', $B1, $B2, $B3> ),
   State_A_1( $A, $B1, $B2, $B3 )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Initiator_Receives_Peer_Keys:
   [
   State_A_1( $A, $B1, $B2, $B3 ),
   S2C_Rcv( 'Server', $A,
            <'2_server_resp', $B1, pkPeerB1, $B2, pkPeerB2, $B3, pkPeerB3>
   )
   ]
  --[ AReceivedPeerKeys( $A, $B1, $B2, $B3 ) ]->
   [ State_A_2( $A, $B1, $B2, $B3, pkPeerB1, pkPeerB2, pkPeerB3 ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Initiator_Sends_Subkeys:
   [
   State_A_2( $A, $B1, $B2, $B3, pkPeerB1, pkPeerB2, pkPeerB3 ),
   !LtkUser( $A, ltkUserA ), Fr( ~r )
   ]
  --[
  SharesDealt( $A, ltkUserA ),
  ASendsKeyPackage( $A, $B1, $B2, $B3,
                    <'3_store_pkg', pk(ltkUserA), srv(ltkUserA, ~r), 
                     aenc(<'share', shr1(ltkUserA, ~r), $A>, pkPeerB1), $B1, 
                     aenc(<'share', shr2(ltkUserA, ~r), $A>, pkPeerB2), $B2, 
                     aenc(<'share', shr3(ltkUserA, ~r), $A>, pkPeerB3), $B3>
  )
  ]->
   [
   C2S_Snd( $A, 'Server',
            <'3_store_pkg', pk(ltkUserA), srv(ltkUserA, ~r), 
             aenc(<'share', shr1(ltkUserA, ~r), $A>, pkPeerB1), $B1, 
             aenc(<'share', shr2(ltkUserA, ~r), $A>, pkPeerB2), $B2, 
             aenc(<'share', shr3(ltkUserA, ~r), $A>, pkPeerB3), $B3>
   ),
   State_A_3( $A, $B1, $B2, $B3, ltkUserA )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Initiator_Starts_Phase2:
   [
   State_A_3( $A, $B1, $B2, $B3, ltkUserA ), Fr( ~fido_key ),
   !PkUser( $A, pkUserA )
   ]
  --[ A_Generates_FIDO_Key( $A, ~fido_key ) ]->
   [
   C2S_Snd( $A, 'Server',
            <'4_store_fido', aenc(<~fido_key, ltkUserA>, pkUserA)>
   ),
   State_A_4( $A, $B1, $B2, $B3, ~fido_key )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Initiate_Recovery:
   [ State_A_4( $A, $B1, $B2, $B3, fido_key ), Fr( ~nonce ) ]
  --[ A_Initiates_Recovery( $A, ~nonce ) ]->
   [
   C2S_Snd( $A, 'Server', <'5_req_recovery', ~nonce> ),
   State_A_Recovery_1( $A, $B1, $B2, $B3, ~nonce )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Initiator_Receives_Recovery_Data:
   [
   State_A_Recovery_1( $A, $B1, $B2, $B3, nonce ),
   In( <'Server', $A, 'recovery_fido', nonce, enc_fido> ),
   In( <'Server', $A, 'recovery_package', nonce, srv_share> )
   ]
  --[ AReceivedRecoveryData( $A, srv_share, enc_fido ) ]->
   [ State_A_Recovery_2( $A, $B1, $B2, $B3, srv_share, enc_fido, nonce ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Initiator_Selects_Helpers_12:
   [ State_A_Recovery_2( $A, $B1, $B2, $B3, srv_share, enc_fido, nonce ) ]
  --[
  ARequestsHelp( $A, $B1 ), ARequestsHelp( $A, $B2 ),
  HelpersSelected( $A, $B1, $B2 ), Neq( $B1, $B2 )
  ]->
   [
   P2P_Snd( $A, $B1, <'7_p2p_help', nonce> ),
   P2P_Snd( $A, $B2, <'7_p2p_help', nonce> ),
   State_A_Recovery_3( $A, $B1, $B2, srv_share, enc_fido, nonce )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Initiator_Selects_Helpers_13:
   [ State_A_Recovery_2( $A, $B1, $B2, $B3, srv_share, enc_fido, nonce ) ]
  --[
  ARequestsHelp( $A, $B1 ), ARequestsHelp( $A, $B3 ),
  HelpersSelected( $A, $B1, $B3 ), Neq( $B1, $B3 )
  ]->
   [
   P2P_Snd( $A, $B1, <'7_p2p_help', nonce> ),
   P2P_Snd( $A, $B3, <'7_p2p_help', nonce> ),
   State_A_Recovery_3( $A, $B1, $B3, srv_share, enc_fido, nonce )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Initiator_Selects_Helpers_23:
   [ State_A_Recovery_2( $A, $B1, $B2, $B3, srv_share, enc_fido, nonce ) ]
  --[
  ARequestsHelp( $A, $B2 ), ARequestsHelp( $A, $B3 ),
  HelpersSelected( $A, $B2, $B3 ), Neq( $B2, $B3 )
  ]->
   [
   P2P_Snd( $A, $B2, <'7_p2p_help', nonce> ),
   P2P_Snd( $A, $B3, <'7_p2p_help', nonce> ),
   State_A_Recovery_3( $A, $B2, $B3, srv_share, enc_fido, nonce )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Initiator_Receives_First_Share:
   [
   State_A_Recovery_3( $A, $H1, $H2, srv_share, enc_fido, nonce ),
   P2P_Rcv( $H1, $A, <'8_qr', share_x, nonce> )
   ]
  --[ AReceivedQR( $A, $H1, share_x ) ]->
   [ State_A_Recovery_4( $A, $H2, share_x, srv_share, enc_fido, nonce ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Initiator_Receives_Second_Share:
   [
   State_A_Recovery_4( $A, $H2, share_x, srv_share, enc_fido, nonce ),
   P2P_Rcv( $H2, $A, <'8_qr', share_y, nonce> )
   ]
  --[
  AReceivedQR( $A, $H2, share_y ),
  A_Receives_Decrypted_Subkeys( $A, $H2, share_x, share_y, nonce )
  ]->
   [ State_A_Recovery_5( $A, share_x, share_y, srv_share, enc_fido, nonce )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Initiator_Reconstructs:
   [
   State_A_Recovery_5( $A, share_x, share_y, srv_share, enc_fido, nonce ),
   !PkUser( $A, pkUserA )
   ]
  --[
  Eq( pk(rec(srv_share, share_x, share_y)), pkUserA ),
  A_Reconstructs_Key( $A, rec(srv_share, share_x, share_y) )
  ]->
   [ State_A_Recovered( $A, enc_fido, rec(srv_share, share_x, share_y) ) ]
 variants
  rule (modulo AC) Initiator_Reconstructs___VARIANT_1:
     [
     State_A_Recovery_5( $A, share_x.1, share_y.2, srv_share.3, enc_fido,
                         nonce
     ),
     !PkUser( $A, pkUserA )
     ]
    --[
    Eq( pk(rec(srv_share.3, share_x.1, share_y.2)), pkUserA ),
    A_Reconstructs_Key( $A, rec(srv_share.3, share_x.1, share_y.2) )
    ]->
     [
     State_A_Recovered( $A, enc_fido, rec(srv_share.3, share_x.1, share_y.2) )
     ]
  ,
  rule (modulo AC) Initiator_Reconstructs___VARIANT_2:
     [
     State_A_Recovery_5( $A, shr1(z.1, x.2), shr2(z.1, x.2), srv(z.1, x.2),
                         enc_fido, nonce
     ),
     !PkUser( $A, pkUserA )
     ]
    --[ Eq( pk(z.1), pkUserA ), A_Reconstructs_Key( $A, z.1 ) ]->
     [ State_A_Recovered( $A, enc_fido, z.1 ) ]
  ,
  rule (modulo AC) Initiator_Reconstructs___VARIANT_3:
     [
     State_A_Recovery_5( $A, shr1(z.1, x.2), shr3(z.1, x.2), srv(z.1, x.2),
                         enc_fido, nonce
     ),
     !PkUser( $A, pkUserA )
     ]
    --[ Eq( pk(z.1), pkUserA ), A_Reconstructs_Key( $A, z.1 ) ]->
     [ State_A_Recovered( $A, enc_fido, z.1 ) ]
  ,
  rule (modulo AC) Initiator_Reconstructs___VARIANT_4:
     [
     State_A_Recovery_5( $A, shr2(z.1, x.2), shr3(z.1, x.2), srv(z.1, x.2),
                         enc_fido, nonce
     ),
     !PkUser( $A, pkUserA )
     ]
    --[ Eq( pk(z.1), pkUserA ), A_Reconstructs_Key( $A, z.1 ) ]->
     [ State_A_Recovered( $A, enc_fido, z.1 ) ]

rule (modulo E) Initiator_Recovers_FIDO_Key:
   [ State_A_Recovered( $A, aenc(<fido, ltkA>, pk(ltkA)), ltkA ) ]
  --[ A_Recovers_FIDO_Key( $A, fido ), RecoveryComplete( $A ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Server_Sends_Peer_Keys:
   [
   C2S_Rcv( $A, 'Server', <'1_init_peer', $B1, $B2, $B3> ),
   !PkPeer( $B1, pkPeerB1 ), !PkPeer( $B2, pkPeerB2 ),
   !PkPeer( $B3, pkPeerB3 ), !RegisteredUser( $A, 'Client' )
   ]
  --[ ServerResponds( $A, $B1, $B2, $B3 ) ]->
   [
   S2C_Snd( 'Server', $A,
            <'2_server_resp', $B1, pkPeerB1, $B2, pkPeerB2, $B3, pkPeerB3>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Server_Receives_And_Forwards_Package:
   [
   C2S_Rcv( $A, 'Server',
            <'3_store_pkg', pkA, srv_share, c1, $B1, c2, $B2, c3, $B3>
   )
   ]
  --[
  AUTO_IN_FACT_0_Server_Receives_And_Forwards_Package( $A, 'Server',
                                                       <'3_store_pkg', pkA, srv_share, c1, $B1, c2, $B2, c3, 
                                                        $B3>
  ),
  ServerStoresPackage( $A, $B1, $B2, $B3, pkA, srv_share ),
  ServerForwardsSubkeys( $A, $B1, $B2, $B3 )
  ]->
   [
   !StoredPackage( $A, $B1, $B2, $B3, pkA, srv_share, c1, c2, c3 ),
   S2C_Snd( 'Server', $B1, <'subkey_package', $A, c1> ),
   S2C_Snd( 'Server', $B2, <'subkey_package', $A, c2> ),
   S2C_Snd( 'Server', $B3, <'subkey_package', $A, c3> )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Server_Receives_FIDO_Key:
   [ C2S_Rcv( $A, 'Server', <'4_store_fido', encrypted_fido_key> ) ]
  --[ ServerStoresFIDOKey( $A, encrypted_fido_key ) ]->
   [ !StoredFIDOKey( $A, encrypted_fido_key ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Server_Sends_Recovery_Data:
   [
   C2S_Rcv( $A, 'Server', <'5_req_recovery', nonce> ),
   !StoredFIDOKey( $A, encrypted_fido_key ),
   !StoredPackage( $A, $B1, $B2, $B3, pkA, srv_share, c1, c2, c3 )
   ]
  --[ ServerSendsRecoveryData( $A, srv_share, encrypted_fido_key ) ]->
   [
   Out( <'Server', $A, 'recovery_fido', nonce, encrypted_fido_key> ),
   Out( <'Server', $A, 'recovery_package', nonce, srv_share> ),
   Out( <'Server', $A, 'subkey_package', c1> ),
   Out( <'Server', $A, 'subkey_package', c2> ),
   Out( <'Server', $A, 'subkey_package', c3> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Peer_Receives_Encrypted_Subkey:
   [ S2C_Rcv( 'Server', $B, <'subkey_package', $A, cipher> ) ]
  --[ B_Stores_Subkey( $B, $A, cipher ) ]->
   [ !StoredEncryptedSubkey( $B, $A, cipher ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Peer_Decrypts_And_Sends_QR:
   [
   P2P_Rcv( $A, $B, <'7_p2p_help', nonce> ),
   !StoredEncryptedSubkey( $B, $A, aenc(<'share', shrX, $A>, pk(ltkPeerB))
   ),
   !LtkPeer( $B, ltkPeerB )
   ]
  --[ PeerHelpsRecovery( $B, $A, shrX, nonce ) ]->
   [ P2P_Snd( $B, $A, <'8_qr', shrX, nonce> ) ]

  /* has exactly the trivial AC variant */

lemma protocol_is_executable_strong [heuristic={executability}]:
  exists-trace
  "∃ A #i.
    ((RecoveryComplete( A ) @ #i) ∧
     (¬(∃ User #k. LtkRevealUser( User ) @ #k))) ∧
    (¬(∃ User #k. LtkRevealPeer( User ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ A #i.
  (RecoveryComplete( A ) @ #i)
 ∧
  (∀ User #k. (LtkRevealUser( User ) @ #k) ⇒ ⊥) ∧
  (∀ User #k. (LtkRevealPeer( User ) @ #k) ⇒ ⊥)"
*/
by sorry

lemma secrecy_share [reuse]:
  all-traces
  "∀ A B s nonce #i.
    (((PeerHelpsRecovery( B, A, s, nonce ) @ #i) ∧
      (¬(∃ #l. LtkRevealUser( A ) @ #l))) ∧
     (¬(∃ #l. LtkRevealPeer( B ) @ #l))) ⇒
    (¬(∃ #z. K( s ) @ #z))"
/*
guarded formula characterizing all counter-examples:
"∃ A B s nonce #i.
  (PeerHelpsRecovery( B, A, s, nonce ) @ #i)
 ∧
  (∀ #l. (LtkRevealUser( A ) @ #l) ⇒ ⊥) ∧
  (∀ #l. (LtkRevealPeer( B ) @ #l) ⇒ ⊥) ∧
  (∃ #z. (K( s ) @ #z))"
*/
by sorry

lemma secrecy_main_key_collusion [reuse,
                                  heuristic={reconstruction_secrecy}]:
  all-traces
  "∀ A ltk #i.
    (((A_Reconstructs_Key( A, ltk ) @ #i) ∧
      (¬(∃ #l. LtkRevealUser( A ) @ #l))) ∧
     (∀ B1 B2 B3 #n.
       (Nominated_All( A, B1, B2, B3 ) @ #n) ⇒
       (((¬(∃ #r1 #r2.
             (LtkRevealPeer( B1 ) @ #r1) ∧ (LtkRevealPeer( B2 ) @ #r2))) ∧
         (¬(∃ #r1 #r2.
             (LtkRevealPeer( B1 ) @ #r1) ∧ (LtkRevealPeer( B3 ) @ #r2)))) ∧
        (¬(∃ #r1 #r2.
            (LtkRevealPeer( B2 ) @ #r1) ∧ (LtkRevealPeer( B3 ) @ #r2)))))) ⇒
    (¬(∃ #z. K( ltk ) @ #z))"
/*
guarded formula characterizing all counter-examples:
"∃ A ltk #i.
  (A_Reconstructs_Key( A, ltk ) @ #i)
 ∧
  (∀ #l. (LtkRevealUser( A ) @ #l) ⇒ ⊥) ∧
  (∀ B1 B2 B3 #n.
    (Nominated_All( A, B1, B2, B3 ) @ #n)
   ⇒
    (∀ #r1 #r2.
      (LtkRevealPeer( B1 ) @ #r1) ∧ (LtkRevealPeer( B2 ) @ #r2) ⇒ ⊥) ∧
    (∀ #r1 #r2.
      (LtkRevealPeer( B1 ) @ #r1) ∧ (LtkRevealPeer( B3 ) @ #r2) ⇒ ⊥) ∧
    (∀ #r1 #r2.
